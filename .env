APP_ENV=development
LOG_LEVEL=INFO

# ==========================================================
# AIRFLOW
# ==========================================================

AIRFLOW_UID=50000
AIRFLOW_PORT=8080

AIRFLOW_DB_PASSWORD=change_this_airflow_db_password

AIRFLOW_FERNET_KEY=PUT_YOUR_GENERATED_FERNET_KEY_HERE
AIRFLOW_JWT_SECRET=PUT_YOUR_GENERATED_JWT_SECRET_HERE

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin@password
AIRFLOW_ADMIN_FIRSTNAME=Data
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.local

AIRFLOW_DEFAULT_WORKER_CONCURRENCY=4

# ==========================================================
# SCRAPING
# ==========================================================

SCRAPE_LIGHT_CONCURRENCY=8
SCRAPE_BROWSER_CONCURRENCY=2

# ==========================================================
# TRANSFORMATION
# ==========================================================

TRANSFORM_CONCURRENCY=4

# ==========================================================
# WAREHOUSE
# ==========================================================

WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_this_warehouse_password
WAREHOUSE_PORT=5433

# ==========================================================
# SEAWEEDFS / S3
# ==========================================================

S3_ACCESS_KEY=scrapingadmin
S3_SECRET_KEY=change_this_s3_secret

S3_REGION=us-east-1

S3_API_PORT=8333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333

S3_BUCKET_RAW=raw
S3_BUCKET_STAGE=stage
S3_BUCKET_CURATED=curated
S3_BUCKET_QUARANTINE=quarantine

# ==========================================================
# FLOWER
# ==========================================================

FLOWER_PORT=5555